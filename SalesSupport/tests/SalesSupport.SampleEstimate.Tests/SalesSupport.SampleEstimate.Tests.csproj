    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SampleEstimate/SalesSupport.SampleEstimate.Web/SalesSupport.SampleEstimate.Web.csproj" />
