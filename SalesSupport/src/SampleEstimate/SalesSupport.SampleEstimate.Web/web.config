<?xml version="1.0" encoding="utf-8"?>
<!-- 発行物のweb.configの元です。再発行しても環境変数が消えないよう、値はこのファイルで管理します。秘密値は書きません。 -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="SalesSupport__Application__ToolId" value="SAMPLE-ESTIMATE" />
          <environmentVariable name="SalesSupport__Application__Name" value="見積試算・案件記録" />
          <!-- サーバー自身のブラウザーで単独モードを確認するときだけ有効にします。HTTPS必須で、他の端末からは利用できず、エラー詳細が画面に出るため、確認後は必ず戻します。
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
          <environmentVariable name="SalesSupport__Tool__ExecutionMode" value="Standalone" />
          <environmentVariable name="SalesSupport__Site__Name" value="営業支援ポータルサイト" />
          -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
