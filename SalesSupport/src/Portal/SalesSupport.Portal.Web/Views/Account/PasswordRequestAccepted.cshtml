@*
    請求の受付表示です。配達の成功を意味しない共通文言だけを表示します。
*@
@section Head {
    <link rel="stylesheet" href="~/css/site.css" />
}
<div class="pt-auth">
    <div class="alert alert-info" role="alert">対象のアカウントが利用可能な場合、設定用メールを送信します。</div>
    <p>メールが届かない場合は、時間をおいて改めて請求するか、社内システム担当へお問い合わせください。</p>
    <p class="pt-links">
        <a asp-controller="Account" asp-action="Login">ログイン画面へ戻る</a>
    </p>
</div>
