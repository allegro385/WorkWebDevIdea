@model LoginViewModel
@*
    P001 ログイン画面です。失敗理由は区別せず、外部システムの利用案内と連絡先だけを補足します。
*@
@section Head {
    <link rel="stylesheet" href="~/css/site.css" />
}
<div class="pt-auth">
    <partial name="_ValidationSummary" />
    <form method="post" asp-controller="Account" asp-action="Login" data-ss-once>
        <input type="hidden" asp-for="Input.ReturnUrl" />
        <div class="pt-field">
            <label class="form-label pt-field-label" asp-for="Input.LoginId">
                ログインID<span class="badge pt-required">必須</span>
            </label>
            <input class="form-control" asp-for="Input.LoginId" type="text" maxlength="256" autocomplete="username" autofocus />
            <span class="pt-field-error" asp-validation-for="Input.LoginId"></span>
        </div>
        <div class="pt-field">
            <label class="form-label pt-field-label" asp-for="Input.Password">
                パスワード<span class="badge pt-required">必須</span>
            </label>
            <input class="form-control" asp-for="Input.Password" type="password" autocomplete="current-password" />
            <span class="pt-field-error" asp-validation-for="Input.Password"></span>
        </div>
        <div class="pt-actions">
            <button type="submit" class="btn btn-primary">ログイン</button>
        </div>
    </form>
    <div class="pt-support">
        <p>連携元システムのログインIDとパスワードを使用してください。パスワードの変更・再設定は連携元システムで行ってください。</p>
        @if (Model.SupportContact is not null)
        {
            <p class="pt-support-contact">@Model.SupportContact</p>
        }
    </div>
</div>
