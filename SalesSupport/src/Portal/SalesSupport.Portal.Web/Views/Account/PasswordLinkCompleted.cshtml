@model PasswordLinkInput
@*
    設定完了の表示です。使用したリンクは無効になっています。
*@
@section Head {
    <meta name="referrer" content="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" />
}
<div class="pt-auth">
    <div class="alert alert-success" role="alert">パスワードを設定しました。新しいパスワードでログインしてください。</div>
    <p class="pt-links">
        <a asp-controller="Account" asp-action="Login">ログイン画面へ</a>
    </p>
</div>
