@model PasswordRequestInput
@*
    P009 パスワード再設定メールの請求画面です。登録有無・送信成否は表示しません。
*@
@section Head {
    <link rel="stylesheet" href="~/css/site.css" />
}
<div class="pt-auth">
    <p class="pt-auth-lead">登録済みのメールアドレスを入力してください。設定用のメールをお送りします。</p>
    <partial name="_ValidationSummary" />
    <form method="post" asp-controller="Account" asp-action="PasswordRequest" data-ss-once>
        <div class="pt-field">
            <label class="form-label pt-field-label" asp-for="Email">
                メールアドレス<span class="badge pt-required">必須</span>
            </label>
            <input class="form-control" asp-for="Email" type="email" maxlength="256" autocomplete="username" autofocus />
            <span class="pt-field-error" asp-validation-for="Email"></span>
        </div>
        <div class="pt-actions">
            <button type="submit" class="btn btn-primary">送信</button>
            <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Login">ログイン画面へ戻る</a>
        </div>
    </form>
</div>
