@*
    期限切れ・使用済み・改変されたリンクの共通案内です。理由は区別しません。
*@
@section Head {
    <meta name="referrer" content="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" />
}
<div class="pt-auth">
    <div class="alert alert-warning" role="alert">このリンクは利用できません。有効期限が切れたか、すでに使用された可能性があります。</div>
    <p>改めて設定用メールを請求してください。</p>
    <p class="pt-links">
        <a asp-controller="Account" asp-action="PasswordRequest">パスワード再設定の請求へ</a>
    </p>
</div>
