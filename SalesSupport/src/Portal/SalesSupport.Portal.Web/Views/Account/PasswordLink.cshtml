@model PasswordLinkInput
@*
    P009 初回パスワード設定・再設定画面です。トークンは入力欄へ再表示せず、hiddenで保持します。
    トークン付きURLからRefererを送信させないため、第三者リソースを読み込みません。
*@
@section Head {
    <meta name="referrer" content="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" />
}
<div class="pt-auth">
    <p class="pt-auth-lead">
        新しいパスワードを入力してください。@PasswordPolicy.MinimumLength 文字以上 @PasswordPolicy.MaximumLength 文字以下で、
        半角の英数字と記号（空白を除く）を使用できます。
    </p>
    <partial name="_ValidationSummary" />
    <form method="post" asp-controller="Account" asp-action="@Model.ActionName" data-ss-once>
        <input type="hidden" asp-for="User" />
        <input type="hidden" asp-for="Token" />
        <div class="pt-field">
            <label class="form-label pt-field-label" asp-for="Password">
                新しいパスワード<span class="badge pt-required">必須</span>
            </label>
            <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" autofocus />
            <span class="pt-field-error" asp-validation-for="Password"></span>
        </div>
        <div class="pt-field">
            <label class="form-label pt-field-label" asp-for="PasswordConfirmation">
                新しいパスワード（確認）<span class="badge pt-required">必須</span>
            </label>
            <input class="form-control" asp-for="PasswordConfirmation" type="password" autocomplete="new-password" />
            <span class="pt-field-error" asp-validation-for="PasswordConfirmation"></span>
        </div>
        <div class="pt-actions">
            <button type="submit" class="btn btn-primary">設定する</button>
        </div>
    </form>
</div>
