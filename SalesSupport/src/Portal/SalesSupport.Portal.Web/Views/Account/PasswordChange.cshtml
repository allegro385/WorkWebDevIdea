@model PasswordChangeInput
@*
    P010 パスワード変更画面です。定期変更の案内は表示しません。
*@
@section Head {
    <link rel="stylesheet" href="~/css/site.css" />
}
<div class="pt-auth">
    <p class="pt-auth-lead">
        現在のパスワードと新しいパスワードを入力してください。新しいパスワードは
        @PasswordPolicy.MinimumLength 文字以上 @PasswordPolicy.MaximumLength 文字以下で、半角の英数字と記号（空白を除く）を使用できます。
    </p>
    <partial name="_ValidationSummary" />
    <form method="post" asp-controller="Account" asp-action="PasswordChange" data-ss-once>
        <div class="pt-field">
            <label class="form-label pt-field-label" asp-for="CurrentPassword">
                現在のパスワード<span class="badge pt-required">必須</span>
            </label>
            <input class="form-control" asp-for="CurrentPassword" type="password" autocomplete="current-password" autofocus />
            <span class="pt-field-error" asp-validation-for="CurrentPassword"></span>
        </div>
        <div class="pt-field">
            <label class="form-label pt-field-label" asp-for="NewPassword">
                新しいパスワード<span class="badge pt-required">必須</span>
            </label>
            <input class="form-control" asp-for="NewPassword" type="password" autocomplete="new-password" />
            <span class="pt-field-error" asp-validation-for="NewPassword"></span>
        </div>
        <div class="pt-field">
            <label class="form-label pt-field-label" asp-for="NewPasswordConfirmation">
                新しいパスワード（確認）<span class="badge pt-required">必須</span>
            </label>
            <input class="form-control" asp-for="NewPasswordConfirmation" type="password" autocomplete="new-password" />
            <span class="pt-field-error" asp-validation-for="NewPasswordConfirmation"></span>
        </div>
        <div class="pt-actions">
            <button type="submit" class="btn btn-primary">変更する</button>
        </div>
    </form>
</div>
