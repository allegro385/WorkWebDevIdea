@*
    変更完了の表示です。既存の認証は終了しているため、再ログインを案内します。
*@
@section Head {
    <link rel="stylesheet" href="~/css/site.css" />
}
<div class="pt-auth">
    <div class="alert alert-success" role="alert">パスワードを変更しました。新しいパスワードでログインしてください。</div>
    <p class="pt-links">
        <a asp-controller="Account" asp-action="Login">ログイン画面へ</a>
    </p>
</div>
