@model ToolSelectionViewModel
@*
    A001 ツール管理のツール選択画面です。非公開を含むすべてのツールを選択対象にします。
    表示順はこの一覧で複数ツールを見ながら並べ替え、一括保存します。
*@
@section Head {
    <link rel="stylesheet" href="~/css/site.css" />
}
<partial name="_OperationMessage" model="Model.Message" />
<partial name="_ValidationSummary" />

<form method="get" asp-area="Admin" asp-controller="Tools" asp-action="Index" class="pt-filter">
    <div class="pt-filter-item">
        <label class="form-label" for="filter-category">カテゴリ</label>
        <select class="form-select" id="filter-category" name="CategoryId">
            <option value="">すべて</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.CategoryId" selected="@(category.CategoryId == Model.Filter.CategoryId)">@category.CategoryName</option>
            }
        </select>
    </div>
    <div class="pt-filter-item">
        <label class="form-label" for="filter-owner">担当者</label>
        <select class="form-select" id="filter-owner" name="OwnerUserId">
            <option value="">すべて</option>
            @foreach (var owner in Model.Owners)
            {
                <option value="@owner.UserId" selected="@(owner.UserId == Model.Filter.OwnerUserId)">@owner.DisplayName</option>
            }
        </select>
    </div>
    <div class="pt-filter-item">
        <label class="form-label" for="filter-status">状態</label>
        <select class="form-select" id="filter-status" name="Status">
            <option value="">すべて</option>
            @foreach (var status in Model.Statuses)
            {
                <option value="@status.CodeValue" selected="@(status.CodeValue == Model.Filter.Status)">@status.CodeName</option>
            }
        </select>
    </div>
    <div class="pt-filter-actions">
        <button type="submit" class="btn btn-primary">絞り込み</button>
        <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Tools" asp-action="Index">条件クリア</a>
    </div>
</form>

<form method="post" asp-area="Admin" asp-controller="Tools" asp-action="SaveOrder" data-ss-once>
    <table class="table pt-admin-table">
        <thead>
            <tr>
                <th scope="col" class="pt-col-order">表示順</th>
                <th scope="col" class="pt-col-category">カテゴリ</th>
                <th scope="col" class="pt-col-name">ツール名</th>
                <th scope="col" class="pt-col-owner">担当者</th>
                <th scope="col" class="pt-col-status">状態</th>
                <th scope="col" class="pt-col-version">現在のバージョン</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Tools.Count == 0)
            {
                <tr>
                    <td colspan="6" class="pt-empty">条件に一致するツールはありません。</td>
                </tr>
            }
            @for (var index = 0; index < Model.Tools.Count; index++)
            {
                var tool = Model.Tools[index];
                <tr>
                    <td>
                        <input type="hidden" name="Rows[@index].ToolId" value="@tool.ToolId" />
                        <input type="hidden" name="Rows[@index].UpdateCount" value="@tool.UpdateCount" />
                        <input class="form-control pt-order-input" type="number" min="0" name="Rows[@index].SortOrder" value="@tool.SortOrder" />
                    </td>
                    <td>@tool.CategoryName</td>
                    <td><a asp-area="Admin" asp-controller="Tools" asp-action="Edit" asp-route-toolId="@tool.ToolId">@tool.ToolName</a></td>
                    <td>@tool.OwnerName</td>
                    <td><code-badge code-type="TOOL_STATUS" code-value="@tool.Status" /></td>
                    <td>@(string.IsNullOrEmpty(tool.Version) ? "未選択" : "Ver." + tool.Version)</td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Tools.Count != 0)
    {
        <div class="pt-actions">
            <button type="submit" class="btn btn-primary">表示順を保存</button>
        </div>
    }
</form>
