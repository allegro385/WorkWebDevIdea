{
  "ConnectionStrings": {
    // 例：Server=サーバー名;Database=DB名;Integrated Security=True;TrustServerCertificate=True
    // TrustServerCertificate=Trueは、自己署名証明書のSQL Serverへ接続するための開発用の指定です。本番の接続文字列には使いません。
    "SalesSupport": ""
  },
  "SalesSupport": {
    "EnvironmentCode": "DEVELOPMENT",
    "Site": {
      "Name": "営業支援ポータルサイト",
      // 認証モードです。EmailOtp（通常）またはAnonymous（ログインなしの公開）を指定します。SalesSupportの直下ではなくSiteの下へ書きます。
      "AuthenticationMode": "EmailOtp",
      // 通信方式です。Https（通常）またはHttp（HTTPSのバインドがない期間）を指定します。Siteの下へ書き、Portal:BaseUrlのスキームと一致させます。
      "TransportMode": "Https"
    },
    "Application": {
      "Name": "営業支援ポータル"
    },
    "Portal": {
      // スキームはSite:TransportModeと一致させ、末尾は/にします。
      "BaseUrl": "https://localhost:7065/"
    },
    "DataProtection": {
      "KeyDirectory": "../keys"
    },
    "Storage": {
      "TemporaryRoot": "../storage/temp",
      "PermanentRoot": "../storage/files",
      "CleanupTimeoutSeconds": 5
    },
    "Mail": {
      "Host": "127.0.0.1",
      "Port": 2525,
      "TlsMode": "StartTls",
      "UserName": "",
      "Password": "",
      "From": "noreply@example.invalid",
      "ReplyTo": "",
      "DevelopmentRecipient": "dev@example.invalid",
      "TimeoutSeconds": 30,
      "MaxRecipients": 1
    },
    "Http": {
      "TimeoutSeconds": 30
    },
    "Logging": {
      "TimeoutSeconds": 3
    },
    "Proxy": {
      "KnownProxies": []
    }
  }
}
